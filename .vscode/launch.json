{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "webRoot": "${workspaceFolder}/dist",
      "url": "file://${workspaceFolder}/dist/sh/otladka.html#{\"filepath\":\"file://${file}\",\"autorun\":true,\"alwaysShowAnswer\":true,\"hideMenu\":true,\"lite\":true}"
    },
    {
      "name": "Firefox",
      "type": "firefox",
      "request": "launch",
      "url": "file://${workspaceFolder}/dist/sh/otladka.html#{\"filepath\":\"file://${file}\",\"autorun\":true,\"alwaysShowAnswer\":true,\"hideMenu\":true,\"lite\":true}",
      "reAttach": true,
      "profile": "default"
    },
  ],
  "inputs": [
    {
      "id": "templatePath",
      "type": "promptString",
      "description": "Относительный путь к шаблону внутри dist (например: zdn/matege2023p/4/1.js)",
      "default": "${file}"
    }
  ]
}
